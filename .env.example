# Copy to .env.local. All optional — the app runs fully without them.

# Gemini writes the plain-English reasons. Unset → built-in template reasons.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# HubSpot private-app token. On procurement approval, one HubSpot Order is
# created per distributor with SKUs as line items. Required scopes:
#   crm.objects.orders.read crm.objects.orders.write crm.pipelines.orders.read
#   crm.objects.line_items.read crm.objects.line_items.write
HUBSPOT_ACCESS_TOKEN=

# Neon Postgres. Saves uploads, runs, decisions, approvals, HubSpot orders and
# settings, and restores the latest run on reload. Unset → nothing is saved.
# Tables are created automatically on first use.
DATABASE_URL=
